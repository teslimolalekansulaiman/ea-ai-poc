# APP image for the authoring service, built on the prebuilt base (Dockerfile.author-base).
# Only the UI build and the code are rebuilt here, so a code change takes a minute or two
# instead of reinstalling torch and docling.
ARG BASE_IMAGE

# ---- Stage 1: build the React UI ----
FROM node:20-bookworm-slim AS ui
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

# ---- Stage 2: the base plus code ----
FROM ${BASE_IMAGE}
WORKDIR /app

# Drift guard: if a dependency was added since the base was built, this installs it (slower,
# but never a broken image). When the base is current it finds everything satisfied.
COPY requirements-serve.txt requirements-author.txt ./
RUN pip install --no-cache-dir -r requirements-author.txt

COPY src/ ./src/
# Files the pipeline and the use-case view read by relative path from the working directory.
COPY menu.json ./
COPY use_cases/ ./use_cases/
COPY scripts/ ./scripts/
COPY prompts/ ./prompts/
COPY --from=ui /ui/dist ./ui/dist
# data/ and docs/samples are restored from buckets at start-up.
RUN mkdir -p data docs/samples

EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn eawiki.api.app:app --host 0.0.0.0 --port ${PORT}"]
