# Copy to `.env` (which is gitignored) and set real values.
# docker-compose and the pipeline read this automatically.

# ArcadeDB (store)
ARCADEDB_PASSWORD=change_me_local

# OpenAI-compatible model API — OpenRouter locally, Pulse in prod (same wire format,
# just a different base URL). Used by backend `openrouter` (alias: openai | pulse).
VLM_PROXY_URL=https://openrouter.ai/api/v1/chat/completions
VLM_MODEL=google/gemini-3.8-flash
VLM_API_KEY=sk-or-...                      # your OpenRouter key

# Embeddings (OpenAI-compatible). EMBED_PROXY_URL defaults to VLM_PROXY_URL with
# /chat/completions -> /embeddings, so you usually only set the model.
EMBED_MODEL=openai/text-embedding-3-small
# EMBED_PROXY_URL=https://openrouter.ai/api/v1/embeddings

# --- Cloud Run (prod split) — ONE variable per line (a .env parses one KEY=value/line) ---
FILE_BACKEND=gcs
GCS_BUCKET=<name-after-you-create-it>
# GCS_PREFIX=                               # optional sub-path within the bucket
HISTORY_BACKEND=postgres
DATABASE_URL=postgresql://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
EAWIKI_SERVE_ONLY=1                         # read-only: add/remove/re-ingest/metamodel disabled
EAWIKI_API_BACKEND=pulse
VLM_PROXY_URL=https://<pulse-host>/v1/chat/completions
VLM_PROXY_KEY=...                           # Pulse key
EAWIKI_ARCADE_URL=http://<vm-internal-ip>:2480    # the VM's ArcadeDB, over the VPC
EAWIKI_ARCADE_PASSWORD=...                   # NOTE: the app connects with EAWIKI_ARCADE_PASSWORD,
                                             # not ARCADEDB_PASSWORD (that one is for docker-compose)